# --- Supabase (PostgreSQL) ---
# Connection string from Supabase: Project Settings > Database > Connection strings.
# Use the "Session pooler" (port 6543) or the direct connection (port 5432).
# Example:
#   postgresql+psycopg://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:[YOUR-PASSWORD]@<host>:6543/postgres
# Keep "postgres" with Supabase; databases are provisioned from the dashboard.
DATABASE_NAME=postgres
# Creates tables on startup. Set to false in production (use migrations).
AUTO_CREATE_TABLES=true

# --- Security ---
# IMPORTANT: use a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- App ---
PROJECT_NAME=Revision Calendar
API_PREFIX=/api
# Comma separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173